#!/bin/sh

#fix weird completion-ignore-case case
#[ X"${2}" = X"on" ] && { shift; shift; }
[ X"${1}" = X"-c" ] && { shift; SHUNDLE_ENV_COLOR="1"; }

#required for clean|install at first deployment time
[ -z "${SHUNDLE_HOME}" ] && SHUNDLE_HOME="${HOME}/.shundle"

#where Expose puts its links. A directory already on your PATH, so that a
#bundle full of commands costs a shell exactly nothing to start
[ -z "${SHUNDLE_BIN}" ] && SHUNDLE_BIN="${HOME}/.bin"

#non interactive git
GIT_TERMINAL_PROMPT=0; export GIT_TERMINAL_PROMPT

if [ X"${SHUNDLE_ENV_COLOR}" = X"1" ]; then
    _BIN_SHUNDLE_ENV_RED='\033[1;31m'
    _BIN_SHUNDLE_ENV_BLUE='\033[1;34m'
    _BIN_SHUNDLE_ENV_GREEN='\033[32;02m'
    _BIN_SHUNDLE_ENV_NORMAL='\033[1;00m'
    _BIN_SHUNDLE_ENV_YELLOW='\033[1;33m'
fi

_usage()
{
    printf "%s\\n" "Usage: shundle [-c] OPTION [ARGS]"
    printf "\\n"
    printf "%s\\n" "  -c                colorize output"
    printf "\\n"
    printf "%s\\n" "  install [plugin]  install new plugin"
    printf "%s\\n" "  remove  [plugin]  delete plugin"
    printf "%s\\n" "  search  [pattern] look up at github available scripts by name"
    printf "%s\\n" "  update  [name]    update everything, one bundle, or one exposed command"
    printf "%s\\n" "  clean             drop bundles and links the rc file stopped asking for"
    printf "%s\\n" "  list    [name]    list bundles, or one of them in full"
    return 1
}

_false()
{
    return 1
}

_whereis()
{
    [ -z "${1}" ] && return 1
    if ! command -v "${1}" 2>/dev/null; then
        return 1
    fi
}

_die()
{
    printf "%s\\n" "${*}"
    exit 1
}

_shundle_aux_loaded()
{
    if [ -z "${1}" ] || [ -z "${2}" ]; then
        return 1
    else
        _shundle_aux_loaded__l="${1}"
        while [ "${_shundle_aux_loaded__l}" ]; do
            _shundle_aux_loaded__option="${_shundle_aux_loaded__l%%,*}"
            [ X"${2}" = X"${_shundle_aux_loaded__option}" ] && return 0
            [ X"${_shundle_aux_loaded__l}" = X"${_shundle_aux_loaded__option}" ] &&\
                _shundle_aux_loaded__l='' || _shundle_aux_loaded__l="${_shundle_aux_loaded__l#*,}"
        done
        return 1
    fi
}

_shundle_aux_options()
{
    [ -z "${SHUNDLE_OPTIONS}" ] || return 0
    [ -z "${SHUNDLE_RC}" ]      && return 1
    _shundle_aux_options__subset="$(awk '/bundle\/shundle/,0 {if($0~"^.*=[^;&]*" && $1!~"^#") print}' "${SHUNDLE_RC}")"
    for _shundle_aux_options__bundle in $(printf "%s" "${_shundle_aux_options__subset}"|\
    awk '{if($0~"([bB][uU][nN][dD][lL][eE]|[pP][lL][uU][gG][iI][nN])="){sub(/([bB][uU][nN][dD][lL][eE]|[pP][lL][uU][gG][iI][nN])=/,"");gsub(/'\''/,"");gsub(/'\"'/,"");print $1}}'); do #'
        SHUNDLE_OPTIONS="${SHUNDLE_OPTIONS}${_shundle_aux_options__bundle},"
    done
}

#===============================================================================
#=================================== Expose ====================================
#===============================================================================
#A bundle does not have to be a plugin. A repository of loose scripts is a
#bundle too, and what it offers is commands, not something to source. Expose is
#how such a bundle says which of its paths are commands:
#
#    Bundle="gh:javier-lopez/learn"
#        Expose="sh/tools"                             the whole directory
#        Expose="perl: !simple-cat !simple-grep"       all of it but those
#        Expose="python/tools: mailgun monkey_typewriter"   only those
#        Expose="python/tools: mailgun simple-*"       a name and a family
#        Expose="perl: !simple-*"                      all of it but a family
#        Expose="sh/tools/ports"                       a single file
#
#The word before the colon is a path inside the repository; the words after are
#names inside it. A name with '!' in front is dropped. If any name comes
#without '!' the list is what to take; if every name has one, it is what to
#leave out. The same idiom the dotfiles .gitignore uses.
#
#A name may be a shell pattern, on either side of the '!'. It is matched inside
#the bundle and nowhere else - in particular not against the directory shundle
#was run from, which is a real risk for a repository of commands and the reason
#the lists are split with globbing switched off. One difference between a
#pattern and a name: a pattern never takes a dotfile or a .md, because nobody
#means the README when they write '*', while a file asked for by its own name
#is linked whatever it is called.
#
#Those paths do three jobs, not one: they are what gets checked out, what gets
#downloaded, and what gets linked into SHUNDLE_BIN.

_shundle_install_name()
{   #the directory a bundle lands in: its basename, without revision or .git.
    #Out here and not inside install because clean asks the same question: what
    #directory does this line of the rc file stand for
    _shundle_install_name__n="${1##*/}"
    _shundle_install_name__n="${_shundle_install_name__n%:*}"
    printf "%s" "${_shundle_install_name__n%.*}"
}

_shundle_expose_spec()
{   #the Expose lines that follow this Bundle in the rc file, one per line.
    #Unlike PostInstall these are single line values: a list has nothing to
    #continue, and a bundle may carry as many of them as it needs
    [ -z "${1}" ] && return 0
    [ -r "${SHUNDLE_RC}" ] || return 0

    awk -v want="${1}" '
        /^[ \t]*#/ { next }
        /([bB]undle|[pP]lugin)=/ {
            cur = $0; sub(/^[^=]*=/, "", cur); gsub(/["\047]/, "", cur)
            sub(/[ \t].*$/, "", cur); next
        }
        /[eE]xpose=/ {
            if (cur != want) next
            v = $0; sub(/^[^=]*=[ \t]*/, "", v)
            q = substr(v, 1, 1)
            if (q == "\047" || q == "\"") {
                v = substr(v, 2); sub(q "[ \t]*(#.*)?$", "", v)
            } else sub(/[ \t]*#.*$/, "", v)
            if (v != "") print v
        }' "${SHUNDLE_RC}"
}

_shundle_expose_paths()
{   #what git is asked to check out, which is not quite what gets linked. A
    #line that lists the names it wants has already said which files those are,
    #so those are the paths git hears about - no reason to carry down the
    #nineteen files in a directory to put two of them on your PATH. A line that
    #only excludes cannot narrow anything, so the directory goes down whole and
    #the exclusions are settled at link time
    printf "%s\\n" "${1}" | awk '
    {
        i = index($0, ":")
        if (i == 0) { p = $0; gsub(/^[ \t]+|[ \t]+$/, "", p); if (p != "") print p; next }

        p = substr($0, 1, i - 1); gsub(/^[ \t]+|[ \t]+$/, "", p)
        if (p == "") next
        n = split(substr($0, i + 1), a, /[ \t]+/)

        white = 0
        for (j = 1; j <= n; j++)
            if (a[j] != "" && substr(a[j], 1, 1) != "!") white++

        if (white == 0) { print p; next }
        for (j = 1; j <= n; j++)
            if (a[j] != "" && substr(a[j], 1, 1) != "!") print p "/" a[j]
    }'
}

_shundle_expose_ln()
{   #one link in SHUNDLE_BIN, and the rules it will not break
    _shundle_expose_ln__name="${1##*/}"
    _shundle_expose_ln__dst="${SHUNDLE_BIN}/${_shundle_expose_ln__name}"

    if [ ! -x "${1}" ]; then
        #a link carries no permissions of its own: PATH lookup follows it and
        #asks the file at the end, so a file the repository committed without
        #its execute bit would become a name your shell cannot run. Better an
        #absent name than a dead one, and the report says which file to fix
        _SHUNDLE_EXPOSE_NOEXEC="${_SHUNDLE_EXPOSE_NOEXEC} ${_shundle_expose_ln__name}"
        return 0
    fi

    if [ -e "${_shundle_expose_ln__dst}" ] && [ ! -L "${_shundle_expose_ln__dst}" ]; then
        #a real file: it may be a copy somebody edited and never versioned, and
        #no installer gets to delete that on a hunch
        _SHUNDLE_EXPOSE_KEPT="${_SHUNDLE_EXPOSE_KEPT} ${_shundle_expose_ln__name}"
        return 0
    fi

    if [ -L "${_shundle_expose_ln__dst}" ]; then
        _shundle_expose_ln__cur="$(readlink "${_shundle_expose_ln__dst}" 2>/dev/null)"
        if [ ! X"${_shundle_expose_ln__cur}" = X"${1}" ] && [ -e "${_shundle_expose_ln__dst}" ]; then
            #something already answers to this name and its file is still
            #there. It need not be another bundle: one repository can carry the
            #same basename in two languages. Last one wins is how a name
            #silently changes meaning, so the first one keeps it
            _SHUNDLE_EXPOSE_CLASH="${_SHUNDLE_EXPOSE_CLASH} ${_shundle_expose_ln__name}"
            return 0
        fi
    fi

    ln -sf "${1}" "${_shundle_expose_ln__dst}" 2>/dev/null &&
        _SHUNDLE_EXPOSE_LINKED="${_SHUNDLE_EXPOSE_LINKED} ${_shundle_expose_ln__name}"
}

_shundle_expose_one()
{   #$1 the bundle directory, $2 one Expose line
    case "${2}" in
        *:*) _shundle_expose_one__path="${2%%:*}"; _shundle_expose_one__sel="${2#*:}" ;;
        *)   _shundle_expose_one__path="${2}";     _shundle_expose_one__sel=""        ;;
    esac
    _shundle_expose_one__path="$(printf "%s" "${_shundle_expose_one__path}" | awk '{$1=$1; print}')"
    [ -z "${_shundle_expose_one__path}" ] && return 0
    _shundle_expose_one__src="${1}/${_shundle_expose_one__path}"

    if [ -f "${_shundle_expose_one__src}" ]; then
        "${_shundle_expose__do:-_shundle_expose_ln}" "${_shundle_expose_one__src}"
        return 0
    fi
    if [ ! -d "${_shundle_expose_one__src}" ]; then
        _SHUNDLE_EXPOSE_MISSING="${_SHUNDLE_EXPOSE_MISSING} ${_shundle_expose_one__path}"
        return 1
    fi

    #the token list is split with globbing off from here on. Splitting needs
    #the variable unquoted, and unquoted is also what makes the shell match
    #'simple-*' against the directory shundle happens to have been run from -
    #which, for a repository of commands, is quite likely to be one that
    #answers. The pattern is meant for the bundle, and it is expanded there,
    #once, below
    case "${-}" in
        *f*) _shundle_expose_one__glob="0" ;;
        *)   _shundle_expose_one__glob="1" ;;
    esac
    set -f

    #one name without '!' turns the list into what to take
    _shundle_expose_one__white=""
    for _shundle_expose_one__w in ${_shundle_expose_one__sel}; do
        case "${_shundle_expose_one__w}" in
            !*) ;;
             *) _shundle_expose_one__white="1" ;;
        esac
    done

    if [ -n "${_shundle_expose_one__white}" ]; then
        for _shundle_expose_one__w in ${_shundle_expose_one__sel}; do
            case "${_shundle_expose_one__w}" in !*) continue ;; esac
            #a name with no wildcard in it expands to itself, so one loop
            #serves 'mailgun' and 'simple-*' alike
            [ "${_shundle_expose_one__glob}" = "1" ] && set +f
            _shundle_expose_one__hit=""
            for _shundle_expose_one__f in "${_shundle_expose_one__src}"/${_shundle_expose_one__w}; do
                [ -f "${_shundle_expose_one__f}" ] || continue
                #naming a file is asking for that file, whatever it is called;
                #naming a pattern is not, and nobody means the README when they
                #write '*'. So the rule that keeps documentation and dotfiles
                #off your PATH applies to patterns and never to exact names
                case "${_shundle_expose_one__w}" in
                    *[*?[]*) case "${_shundle_expose_one__f##*/}" in
                                 .*|*.md) continue ;;
                             esac ;;
                esac
                _shundle_expose_one__hit="1"
                "${_shundle_expose__do:-_shundle_expose_ln}" "${_shundle_expose_one__f}"
            done
            set -f
            #a pattern that matched nothing is as wrong as a name that is not
            #there, and reads the same way in the report
            [ -n "${_shundle_expose_one__hit}" ] ||
                _SHUNDLE_EXPOSE_MISSING="${_SHUNDLE_EXPOSE_MISSING} ${_shundle_expose_one__path}/${_shundle_expose_one__w}"
        done
        [ "${_shundle_expose_one__glob}" = "1" ] && set +f
        return 0
    fi

    [ "${_shundle_expose_one__glob}" = "1" ] && set +f
    for _shundle_expose_one__f in "${_shundle_expose_one__src}"/*; do
        [ -f "${_shundle_expose_one__f}" ] || continue
        _shundle_expose_one__n="${_shundle_expose_one__f##*/}"
        #a dotfile is configuration and a .md is documentation; neither is a
        #command, and linking them puts noise in your PATH
        case "${_shundle_expose_one__n}" in .*|*.md) continue ;; esac
        _shundle_expose_one__skip=""
        #globbing off again to split the list, on the same grounds as above.
        #'case' still matches patterns with -f set: it is pathname expansion
        #that is switched off, not pattern matching, which is what lets
        #'!simple-*' exclude the family the way '!simple-cat' excludes the file
        set -f
        for _shundle_expose_one__w in ${_shundle_expose_one__sel}; do
            case "${_shundle_expose_one__w}" in !*) ;; *) continue ;; esac
            case "${_shundle_expose_one__n}" in
                ${_shundle_expose_one__w#!}) _shundle_expose_one__skip="1" ;;
            esac
        done
        [ "${_shundle_expose_one__glob}" = "1" ] && set +f
        [ -n "${_shundle_expose_one__skip}" ] ||
            "${_shundle_expose__do:-_shundle_expose_ln}" "${_shundle_expose_one__f}"
    done
}

_shundle_expose_want()
{   #the dry run of _shundle_expose_ln: not a link, just where one would point.
    #Same walk, same rules, same exclusions - clean must not reimplement what
    #install decided, or the two drift and it deletes something in use
    _SHUNDLE_EXPOSE_WANT="${_SHUNDLE_EXPOSE_WANT}${1}
"
}

_shundle_expose_wanted()
{   #every file the rc file currently asks for, one per line
    _shundle_aux_options
    _SHUNDLE_EXPOSE_WANT=""
    _shundle_expose__do="_shundle_expose_want"

    _shundle_expose_wanted__list="${SHUNDLE_OPTIONS}"
    while [ -n "${_shundle_expose_wanted__list}" ]; do
        _shundle_expose_wanted__b="${_shundle_expose_wanted__list%%,*}"
        [ X"${_shundle_expose_wanted__list}" = X"${_shundle_expose_wanted__b}" ] &&
            _shundle_expose_wanted__list="" ||
            _shundle_expose_wanted__list="${_shundle_expose_wanted__list#*,}"
        [ -z "${_shundle_expose_wanted__b}" ] && continue

        _shundle_expose_wanted__spec="$(_shundle_expose_spec "${_shundle_expose_wanted__b}")"
        [ -z "${_shundle_expose_wanted__spec}" ] && continue
        _shundle_expose_link \
            "${SHUNDLE_HOME}/bundle/$(_shundle_install_name "${_shundle_expose_wanted__b}")" \
            "${_shundle_expose_wanted__spec}"
    done

    _shundle_expose__do=""
    printf "%s" "${_SHUNDLE_EXPOSE_WANT}"
}

_shundle_expose_orphans()
{   #links of ours that nothing asks for any more: the bundle left the rc file,
    #or its Expose line stopped naming them. Only ours - a link in SHUNDLE_BIN
    #that points somewhere else is somebody else's and none of our business
    [ -d "${SHUNDLE_BIN}" ] || return 0
    #an rc we could not read would make every link look unwanted, and that is
    #a directory full of your commands. Say nothing rather than guess
    [ -r "${SHUNDLE_RC}" ] || return 0
    #read here and not from what the command substitution below leaves behind:
    #that runs in a subshell, and nothing it learns comes back
    _shundle_aux_options
    [ -z "${SHUNDLE_OPTIONS}" ] && return 0
    _shundle_expose_orphans__want="$(_shundle_expose_wanted)"

    for _shundle_expose_orphans__f in "${SHUNDLE_BIN}"/*; do
        [ -L "${_shundle_expose_orphans__f}" ] || continue
        _shundle_expose_orphans__t="$(readlink "${_shundle_expose_orphans__f}" 2>/dev/null)"
        case "${_shundle_expose_orphans__t}" in
            "${SHUNDLE_HOME}/bundle/"*) ;;
            *) continue ;;
        esac
        #newline on both sides, and the closing one put back by hand: command
        #substitution eats the trailing newline, which would leave the last
        #path in the list matching nothing and looking abandoned
        case "
${_shundle_expose_orphans__want}
" in
            *"
${_shundle_expose_orphans__t}
"*) continue ;;
        esac
        printf "%s\\n" "${_shundle_expose_orphans__f}"
    done
}

_shundle_expose_link()
{   #$1 the bundle directory, $2 its whole Expose spec
    [ -z "${2}" ] && return 0
    [ -n "${_shundle_expose__do}" ] || [ -d "${SHUNDLE_BIN}" ] ||
        mkdir -p "${SHUNDLE_BIN}" 2>/dev/null || return 1

    #newline is the only separator here: an Expose line has spaces in it
    _shundle_expose_link__ifs="${IFS}"
    IFS="
"
    for _shundle_expose_link__line in ${2}; do
        IFS="${_shundle_expose_link__ifs}"
        _shundle_expose_one "${1}" "${_shundle_expose_link__line}"
        IFS="
"
    done
    IFS="${_shundle_expose_link__ifs}"
}

_shundle_expose_report()
{
    [ -n "${_SHUNDLE_EXPOSE_LINKED}" ] &&
        printf "\\n [*] Expose linked %s command(s) into %s" \
            "$(printf "%s" "${_SHUNDLE_EXPOSE_LINKED}" | wc -w)" "${SHUNDLE_BIN}"
    [ -n "${_SHUNDLE_EXPOSE_KEPT}" ] && {
        printf "\\n [!] left alone, a real file is already there:"
        printf "%s" "${_SHUNDLE_EXPOSE_KEPT}"
        printf "\\n     move or delete them and run install again to link these"; }
    [ -n "${_SHUNDLE_EXPOSE_CLASH}" ] && {
        printf "\\n [!] two paths want the same name, the first one kept it:"
        printf "%s" "${_SHUNDLE_EXPOSE_CLASH}"; }
    [ -n "${_SHUNDLE_EXPOSE_MISSING}" ] && {
        printf "\\n [!] Expose names a path the bundle does not have:"
        printf "%s" "${_SHUNDLE_EXPOSE_MISSING}"; }
    [ -n "${_SHUNDLE_EXPOSE_NOEXEC}" ] && {
        printf "\\n [!] not executable in the bundle, so not a command:"
        printf "%s" "${_SHUNDLE_EXPOSE_NOEXEC}"
        printf "\\n     chmod +x them where they live and run install again"; }
    return 0
}

_shundle_update_command()
{   #bring one exposed command forward without moving the rest of its checkout.
    #Only for what Expose linked: those are loose scripts that do not read each
    #other, so one of them being newer than its neighbours means nothing. In a
    #plugin, where the files do read each other, it would mean plenty
    [ -z "${1}" ] && return 1
    _shundle_update_command__link="${SHUNDLE_BIN}/${1}"

    if [ ! -L "${_shundle_update_command__link}" ]; then
        printf "\\n%s\\n" "shundle: '${1}' is not a bundle, and ${SHUNDLE_BIN}/${1} is not a link to one" >&2
        return 1
    fi

    _shundle_update_command__target="$(readlink "${_shundle_update_command__link}" 2>/dev/null)"
    case "${_shundle_update_command__target}" in
        "${SHUNDLE_HOME}/bundle/"*) ;;
        *) printf "\\n%s\\n" "shundle: '${1}' points outside ${SHUNDLE_HOME}/bundle, not mine to update" >&2
           return 1 ;;
    esac

    #the first path component after bundle/ is the bundle, the rest is the file
    _shundle_update_command__rest="${_shundle_update_command__target#"${SHUNDLE_HOME}/bundle/"}"
    _shundle_update_command__name="${_shundle_update_command__rest%%/*}"
    _shundle_update_command__file="${_shundle_update_command__rest#*/}"
    _shundle_update_command__dir="${SHUNDLE_HOME}/bundle/${_shundle_update_command__name}"

    printf "\\n [+] Command '%s' from bundle '%s' " "${1}" "${_shundle_update_command__name}"
    #FETCH_HEAD and not a tracking branch: these clones are shallow, and it is
    #the one ref a plain fetch is guaranteed to leave behind
    _shundle_install__error="$(cd "${_shundle_update_command__dir}" &&
        git fetch -q origin 2>&1 >/dev/null &&
        git checkout FETCH_HEAD -- "${_shundle_update_command__file}" 2>&1 >/dev/null)" || {
        printf "    %s" "failed"; printf "\\n%s\\n" "${_shundle_install__error}" >&2; return 1; }

    #the file now sits ahead of HEAD and git will say so until a full update
    #fast forwards the rest onto it, at which point the difference disappears
    printf "\\n [*] %s\\n" "${_shundle_update_command__file} is at the latest, run 'shundle update' to bring the rest"
    return 0
}

_shundle_install()
{
    [ X"${1}" = X"update" ] && { _shundle_install__update="true"; shift; }

    _shundle_install_header()
    {
        [ -z "${_shundle_install_header__init}" ] || return 0 #run only once
        printf "Installing bundles to %s" "${SHUNDLE_HOME}/bundle"
        _shundle_install_header__init="true"
    }

    _shundle_install_post()
    {   #the PostInstall line that follows this Bundle in the rc file, run once
        #the bundle is on disk. It runs on a fresh install and on update, never
        #when a shell starts: this is for what a plugin needs fetched or built,
        #not for configuration
        { [ -z "${1}" ] || [ -z "${2}" ]; } && return 0
        [ -r "${SHUNDLE_RC}" ] || return 0

        _shundle_install_post__cmd="$(awk -v want="${1}" '
            /^[ \t]*#/ { next }
            /([bB]undle|[pP]lugin)=/ {
                cur = $0; sub(/^[^=]*=/, "", cur); gsub(/["\047]/, "", cur)
                sub(/[ \t].*$/, "", cur); next
            }
            #a value that does not close on its own line keeps going: a command
            #long enough to be worth a PostInstall is a command worth wrapping,
            #and reading only the first line of it truncates it into nonsense
            open != "" {
                cmd = cmd "\n" $0
                if (sub(open "[ \t]*(#.*)?$", "", cmd)) { print cmd; exit }
                next
            }
            /[pP]ost[iI]nstall=/ {
                if (cur != want) next
                cmd = $0; sub(/^[^=]*=[ \t]*/, "", cmd)
                open = substr(cmd, 1, 1)
                if (open != "\047" && open != "\"") { print cmd; exit }
                cmd = substr(cmd, 2)
                if (sub(open "[ \t]*(#.*)?$", "", cmd)) { print cmd; exit }
                next
            }' "${SHUNDLE_RC}")"
        [ -n "${_shundle_install_post__cmd}" ] || return 0

        printf "\\n [*] PostInstall '%s' " "${_shundle_install_post__cmd}"
        #from the plugin's own directory when there is one, so the command can
        #name its files without repeating the bundle's name
        ( if [ -d "${2}/${2##*/}" ]; then cd "${2}/${2##*/}" || exit 1
          else cd "${2}" || exit 1; fi
          sh -c "${_shundle_install_post__cmd}" ) || printf "%s" "failed"
    }

    _shundle_install_aux()
    {
        [ -z "${1}" ] && return 0
        _shundle_install_header
        printf "\\n [+] Bundle '%s' " "${1}"

        _shundle_install_aux__name="$(_shundle_install_name "${1}")"
        if [ -d "${SHUNDLE_HOME}/bundle/${_shundle_install_aux__name}" ]; then
            _shundle_install_aux__had="1"
        else
            _shundle_install_aux__had=""
        fi

        #read before the clone, because the paths it names are what the clone
        #will ask git for. Kept in a variable the handlers can see: the rc knows
        #this bundle by the string written in it, which is what we were given
        _shundle_install__expose="$(_shundle_expose_spec "${1}")"

        _shundle_install__handler="${1%%:*}:"
        _shundle_install__bundle="${1#$_shundle_install__handler}"

        case "${_shundle_install__handler}" in
            ''|*/*) case "${1}" in
                    /*|~*|\$*) _shundle_install_local  "${1}" ;;
                    *)         _shundle_install_github "${1}" ;;
                esac
                ;;
            gh*|github*|git@github.com*) _shundle_install_github "${_shundle_install__bundle}"    ;;
            git*)                        _shundle_install_git    "${_shundle_install__bundle}"    ;;
            file*)                       _shundle_install_local  "${_shundle_install__bundle#//}" ;;
            http*|https*|ftp*)           _shundle_install_web    "${1}"                           ;;
            *) _shundle_install__error="unknown handler: "${_shundle_install__handler}""; _false  ;;
        esac
        #Bundle 'gh:javier-lopez/shundle-plugins/eternalize'
        #Bundle 'github:javier-lopez/shundle-plugins/colorize'
        #Bundle 'git@github.com:javier-lopez/shundle-plugins/aliazator'
        #Bundle 'username/repository'
        #Bundle 'username/repository.git'
        #Bundle 'username/repository:master'
        #Bundle 'username/repository.git:1234567'

        #Bundle 'https://domain.tld/path/awesome-script'
        #Bundle 'http://domain.tld/path/awesome-script'
        #Bundle 'ftp://domain.tld/path/awesome-script'

        #Bundle 'file://~/path/awesome-script'
        #Bundle 'file://$HOME/path/awesome-script'
        #Bundle 'file://home/username/path/awesome-script'
        #Bundle '/home/username/path/awesome-script'
        #Bundle '$HOME/path/awesome-script'

        #TODO 29-07-2014 13:52 >> add debug information on fail
        [ X"${?}" = X"0" ] || { printf "    %s" "failed"; printf "\\n%s" "${_shundle_install__error}"; }

        #only for a bundle that was just cloned, or refreshed by 'update'
        if [ -z "${_shundle_install_aux__had}" ] || [ -n "${_shundle_install__update}" ]; then
            _shundle_install_post "${1}" "${SHUNDLE_HOME}/bundle/${_shundle_install_aux__name}"
        fi

        #the links go up every time, not only on a fresh clone: a bundle that
        #gained a command should hand it to you without being reinstalled
        _shundle_expose_link "${SHUNDLE_HOME}/bundle/${_shundle_install_aux__name}" \
                             "${_shundle_install__expose}"
    }

    _shundle_install_github()
    {
        _shundle_install_github__default_protocol="https"
        _shundle_install_github__revision=":${1##*:}"
        _shundle_install_github__bundle="${1%$_shundle_install_github__revision}"

        if [ "${GIT_VERSION}" -lt "230" ]; then #non interactive git
            _shundle_install_github__credentials="git::@"
        fi

        _shundle_install_github__author="${_shundle_install_github__bundle%/*}"
        _shundle_install_github__rep="${_shundle_install_github__bundle#*/}"

        case "${_shundle_install_github__rep}" in
            */*) _shundle_install_github__rep="" ;;
        esac

        _shundle_install__url="${_shundle_install_github__default_protocol}"
        _shundle_install__url="${_shundle_install__url}://${_shundle_install_github__credentials}github.com"
        _shundle_install__url="${_shundle_install__url}/${_shundle_install_github__author}/${_shundle_install_github__rep}"

        _shundle_install_github__bundle="${_shundle_install_github__bundle##*/}"
        _shundle_install_github__bundle="${_shundle_install_github__bundle%.*}"

        #what the sparse checkout will ask for. A bundle that names a plugin is
        #a directory inside the repository; a bundle that Exposes paths says so
        #itself, and its own name is not a directory in there at all - asking
        #for it would check out nothing
        if [ -n "${_shundle_install__expose}" ]; then
            _shundle_install_github__sparse="$(_shundle_expose_paths "${_shundle_install__expose}")"
            #blobs the checkout will never write are blobs not worth fetching.
            #Needs git 2.19 on this side and a server that answers, which
            #github does; anything older just carries the whole repository
            if [ "${GIT_VERSION}" -ge "219" ]; then
                _shundle_install_github__filter="--filter=blob:none"
            else
                _shundle_install_github__filter=""
            fi
            #and nothing is written before the narrowing is in place: a clone
            #that checks out first fetches every blob on the way, which is
            #exactly what the filter was there to avoid
            _shundle_install_github__filter="${_shundle_install_github__filter} --no-checkout"
        else
            _shundle_install_github__sparse="${_shundle_install_github__bundle}"
            _shundle_install_github__filter=""
        fi

        if [ -d "${SHUNDLE_HOME}/bundle/${_shundle_install_github__bundle}" ] && [ -z "${_shundle_install__update}" ]; then
            #already installed and without a request for update
            return 0
        else
            if [ -d "${SHUNDLE_HOME}/bundle/${_shundle_install_github__bundle}/.git" ]; then
                if [ X"${_shundle_install_github__revision}" = X":${1}" ]; then
                    _shundle_install__error="$(cd "${SHUNDLE_HOME}/bundle/${_shundle_install_github__bundle}" &&
                     printf "%s\\n" "${_shundle_install_github__sparse}" > .git/info/sparse-checkout &&
                     git pull 2>&1 >/dev/null && git submodule update --init --recursive 2>&1 >/dev/null)"
                fi
            else
                if [ X"${_shundle_install_github__revision}" = X":${1}" ]; then
                    _shundle_install__error="$(cd "${SHUNDLE_HOME}"/bundle &&
                    git clone -q --depth=1 ${_shundle_install_github__filter} "${_shundle_install__url}" "${_shundle_install_github__bundle}" 2>&1 >/dev/null &&
                    cd "${_shundle_install_github__bundle}" && git config core.sparsecheckout true 2>&1 >/dev/null         &&
                    printf "%s\\n" "${_shundle_install_github__sparse}" > .git/info/sparse-checkout &&
                    git read-tree -m -u HEAD 2>&1 >/dev/null)"
                else
                    _shundle_install__error="$(cd "${SHUNDLE_HOME}"/bundle &&
                    git clone -q "${_shundle_install__url}" "${_shundle_install_github__bundle}" 2>&1 >/dev/null &&
                    cd "${_shundle_install_github__bundle}" &&
                    git checkout -q "${_shundle_install_github__revision#:}" 2>&1 >/dev/null &&
                    git config core.sparsecheckout true 2>&1 >/dev/null &&
                    printf "%s\\n" "${_shundle_install_github__sparse}" > .git/info/sparse-checkout &&
                    git read-tree -m -u HEAD 2>&1 >/dev/null)"
                fi
            fi
        fi

        #1.- checkout everything, delete extra data (currently using this method)
        #------------------------------------------------------------------------
        #git clone --dept=1 somerepo somedir
        #cd somedir
        #git config core.sparsecheckout true
        #printf "%s\\n" "test" > .git/info/sparse-checkout
        #git read-tree -m -u HEAD

        #2.- checkout specific directories, for some weird reason it download more stuff this way
        #----------------------------------------------------------------------------------------
        #mkdir plugin1
        #cd plugin1
        #git init
        #git config core.sparseCheckout true
        #echo 'plugin1/' >.git/info/sparse-checkout
        #git remote add -f origin http://url.git
        #git pull origin master

        #3.- checkout everything, delete meta data, it works but makes a sucky update system
        #-----------------------------------------------------------------------------------
        #git clone https://github.com/javier-lopez/t plugin1
        #cd plugin1
        #git filter-branch --prune-empty --subdirectory-filter plugin1 -- --all
        #git reflog expire --expire=now --all
        #git gc --aggressive --prune=now

        #4.- checkout specific directories, delete meta data, it works but makes a sucky update system
        #---------------------------------------------------------------------------------------------
        #mkdir plugin1
        #cd plugin1
        #git init
        #git config core.sparseCheckout true
        #echo 'plugin1/' >.git/info/sparse-checkout
        #git remote add -f https://github.com/javier-lopez/t
        #git pull origin master
        #git filter-branch --prune-empty --subdirectory-filter plugin1 -- --all
        #git reflog expire --expire=now --all
        #git gc --aggressive --prune=now
    }

    _shundle_install_git()
    {
        #mkdir plugin1
        #cd plugin1
        #git init
        #git config core.sparseCheckout true
        #echo 'plugin1/' >.git/info/sparse-checkout
        #git remote add -f origin http://url.git
        #git pull origin master
        printf "%s\\n" "Raw git installation has not been defined"
    }

    _shundle_install_web()
    {
        _shundle_install_web__plugin="${1##*/}"
        _shundle_install_web__plugin="${_shundle_install_web__plugin%.*}"

        if [ -d "${SHUNDLE_HOME}/bundle/${_shundle_install_web__plugin}" ] && [ -z "${_shundle_install__update}" ]; then
            return 0
        else
            if [ -d "${SHUNDLE_HOME}/bundle/${_shundle_install_web__plugin}/bin" ]; then
                _shundle_install__error="$(cd "${SHUNDLE_HOME}/bundle/${_shundle_install_web__plugin}/bin" 2>&1 >/dev/null &&
                mkdir -p old 2>&1 >/dev/null && mv "${1##*/}" old/ 2>&1 >/dev/null &&
                { ${WGET} "${1}" 2>&1 >/dev/null && rm -rf old/* || { mv old/* . 2>&1 >/dev/null; _false; } })"
            else
                _shundle_install__error="$(cd "${SHUNDLE_HOME}"/bundle 2>&1 >/dev/null &&
                mkdir "${_shundle_install_web__plugin}" 2>&1 >/dev/null     &&
                mkdir "${_shundle_install_web__plugin}/bin" 2>&1 >/dev/null &&
                cd "${_shundle_install_web__plugin}/bin" 2>&1 >/dev/null && ${WGET} "${1}" 2>&1 >/dev/null &&
                chmod +x "${1##*/}" 2>&1 >/dev/null &&
                printf "%s\\n" "# Name:         ${_shundle_install_web__plugin}" > ../"${_shundle_install_web__plugin}" &&
                printf "%s\\n" "# Author:       unknown"        >> ../"${_shundle_install_web__plugin}" &&
                printf "%s\\n" "# Description:  remote script"  >> ../"${_shundle_install_web__plugin}" &&
                printf "%s\\n" "# Licence:      unknown"        >> ../"${_shundle_install_web__plugin}" &&
                printf "%s\\n" "# Source:       ${1}"           >> ../"${_shundle_install_web__plugin}" &&
                printf "%s\\n" "# Version:      0.1"            >> ../"${_shundle_install_web__plugin}" &&
                printf "%s\\n" "# Shell:        $(awk -F"/" '{print $NF; exit}' "${1##*/}")" >> ../"${_shundle_install_web__plugin}" &&
                printf "%s\\n" "# Depends:      none"           >> ../"${_shundle_install_web__plugin}" &&
                printf "\\n%s\\n" "_shundle_expose ${_shundle_install_web__plugin}=\"${SHUNDLE_HOME}/bundle/${_shundle_install_web__plugin}/bin/${1##*/}\"" >> ../"${_shundle_install_web__plugin}" &&
                printf "\\n%s\\n" "# vim: set ts=8 sw=4 tw=0 ft=sh :" >> ../"${_shundle_install_web__plugin}")"
            fi
        fi
    }

    _shundle_install_local()
    {
        _shundle_install_local__plugin="${1##*/}"
        _shundle_install_local__plugin="${_shundle_install_local__plugin%.*}"

        case "${1}" in
            \$*)   _shundle_install_local__orig="$(eval "printf "%s" "${1}"")" ;;
            '~'/*) _shundle_install_local__orig="${HOME}/${1#\~/}" ;;
            *)     _shundle_install_local__orig="/${1}" ;;
        esac

        if [ -d "${SHUNDLE_HOME}/bundle/${_shundle_install_local__plugin}" ] && [ -z "${_shundle_install__update}" ]; then
            return 0
        else
            if [ -d "${SHUNDLE_HOME}/bundle/${_shundle_install_local__plugin}/bin" ]; then
                _shundle_install__error="$(cd "${SHUNDLE_HOME}/bundle/${_shundle_install_local__plugin}/bin" 2>&1 >/dev/null &&
                mkdir -p old 2>&1 >/dev/null && mv "${1##*/}" old/ 2>&1 >/dev/null &&
                { cp "${_shundle_install_local__orig}" . 2>&1 >/dev/null && rm -rf old/* 2>&1 >/dev/null || { mv old/* . 2>&1 >/dev/null ; _false ; } })"
            else
                _shundle_install__error="$(cd "${SHUNDLE_HOME}"/bundle 2>&1 >/dev/null &&
                mkdir "${_shundle_install_local__plugin}" 2>&1 >/dev/null &&
                mkdir "${_shundle_install_local__plugin}/bin" 2>&1 >/dev/null &&
                cd "${_shundle_install_local__plugin}/bin" 2>&1 >/dev/null &&
                cp "${_shundle_install_local__orig}" . 2>&1 >/dev/null  &&
                chmod +x "${1##*/}" 2>&1 >/dev/null &&
                printf "%s\\n" "# Name:         ${_shundle_install_local__plugin}" > ../"${_shundle_install_local__plugin}" &&
                printf "%s\\n" "# Author:       unknown"        >> ../"${_shundle_install_local__plugin}" &&
                printf "%s\\n" "# Description:  local script" >> ../"${_shundle_install_local__plugin}"   &&
                printf "%s\\n" "# Licence:      unknown"        >> ../"${_shundle_install_local__plugin}" &&
                printf "%s\\n" "# Source:       ${1}"           >> ../"${_shundle_install_local__plugin}" &&
                printf "%s\\n" "# Version:      0.1"            >> ../"${_shundle_install_local__plugin}" &&
                printf "%s\\n" "# Shell:        $(awk -F"/" '{print $NF; exit}' "${1##*/}")" >> ../"${_shundle_install_local__plugin}" &&
                printf "%s\\n" "# Depends:      none"           >> ../"${_shundle_install_local__plugin}" &&
                printf "\\n%s\\n" "_shundle_expose ${_shundle_install_local__plugin}=\"${1}\"" >> ../"${_shundle_install_local__plugin}" &&
                printf "\\n%s\\n" "# vim: set ts=8 sw=4 tw=0 ft=sh :" >> ../"${_shundle_install_local__plugin}")"
            fi
        fi
    }

    #an argument to update is a name, not a bundle to go and fetch: it picks
    #from what the rc file already declares. 'shundle install foo' still means
    #install this thing I am naming, which is a different question
    if [ -z "${1}" ] || [ -n "${_shundle_install__update}" ]; then
        _shundle_install__filter="${1}"
        _shundle_aux_options #read Bundle definitions from SHUNDLE_RC and save them to SHUNDLE_OPTIONS
        _shundle_install__array="${SHUNDLE_OPTIONS}"
        _shundle_install__hit=""

        while [ "${_shundle_install__array}" ]; do
            _shundle_install__element="${_shundle_install__array%%,*}"
            #advance first: a filtered iteration that skips before advancing
            #never reaches the end of the list
            [ X"${_shundle_install__array}" = X"${_shundle_install__element}" ] &&\
                _shundle_install__array='' || _shundle_install__array="${_shundle_install__array#*,}"
            [ -z "${_shundle_install__element}" ] && continue

            if [ -n "${_shundle_install__filter}" ]; then
                [ X"$(_shundle_install_name "${_shundle_install__element}")" \
                    = X"${_shundle_install__filter}" ] || continue
            fi
            _shundle_install__hit="1"
            _shundle_install_aux "${_shundle_install__element}"
        done

        if [ -n "${_shundle_install__filter}" ] && [ -z "${_shundle_install__hit}" ]; then
            #not a bundle. It may still be a command one of them exposed, and
            #that is the finest grain there is: one file, brought forward on
            #its own while the rest of the checkout stays where it was
            _shundle_update_command "${_shundle_install__filter}" || return 1
        fi
    else
        for _shundle_install_param; do
            _shundle_install_aux "${_shundle_install_param}"
        done
    fi
    _shundle_expose_report
    printf "\\n"

    #TODO 02-10-2013 05:12 >> activate newly added bundles?
}

#TODO 14-09-2026 03:40 >> nothing undoes what a PostInstall did outside the
#bundle - a line in the crontab, a file in ~/.local, a service - and the bundle
#is deleted below with that still in place. A crontab line calling a script
#that no longer exists is a mail from cron every night for as long as the
#machine lives.
#
#The obvious answer, a PreRm beside PostInstall in the rc file, does not hold:
#'clean' removes the bundles the rc file no longer asks for, so the line that
#would carry the instruction is the line that was just deleted. Reading
#commented-out blocks covers the habit of commenting a section instead of
#cutting it, and only that habit - deleting is supported and cannot be read.
#
#The alternative, written down and deliberately not built: a .shundle/
#directory at the root of a bundle, carrying a prerm this would run from the
#bundle directory before the rm. It survives its own rc entry being deleted,
#because it is not in the rc file at all. Two things are needed for it to work
#at all: the sparse checkout of a bundle that Exposes paths has to ask for
#/.shundle/ by name, or the file stays in the index and never reaches the disk;
#and 'update' has to read-tree after the pull, or a pattern added to the spec
#names files git already has and leaves alone.
#
#It was not taken because a bundle would then answer to two contracts for the
#same question, the rc file's and its own, and a rule nobody can state in one
#sentence is worse than no rule. Until one of the two is chosen outright, what
#a bundle put outside itself is the user's to take back: for wcd that is
#'wcd --no-cron', which removes its crontab line.
_shundle_remove()
{
    for _shundle_remove_param; do
        [ X"${_shundle_remove_param}" = X"shundle" ] && _die "shundle: cannot remove myself!"
        if [ -d "${SHUNDLE_HOME}/bundle/${_shundle_remove_param}" ]; then
            printf "%s\\n" "[-] removing ${_shundle_remove_param}"
            rm -rf "${SHUNDLE_HOME}/bundle/${_shundle_remove_param}"
        fi
    done
}

_shundle_search()
{
    printf "%s\\n" "search module has not been defined"
    #TODO 02-10-2013 05:12 >> show description in search results
}

_shundle_update()
{   #no argument is everything, a bundle name is that bundle, and anything else
    #is looked up as a command some bundle exposed
    _shundle_install update "${@}"

    #a command that left its bundle - archived, renamed, deleted upstream -
    #leaves a link in SHUNDLE_BIN pointing at a file that is no longer there,
    #and update is the very operation that does it. Sweeping here rather than
    #waiting for clean is the difference between an update that finishes the
    #job and one that leaves the directory inconsistent until you remember.
    #
    #Only the links: clean's other half is rm -rf over a bundle directory, and
    #that one must stay a thing you ask for by name. And only on a full update:
    #with an argument this is a narrow operation, and sweeping links belonging
    #to bundles nobody named would be a surprise
    [ -n "${1}" ] && return 0
    _shundle_expose_orphans | while IFS= read -r _shundle_update__link; do
        printf "%s\\n" "[-] unlinking ${_shundle_update__link##*/}"
        rm -f "${_shundle_update__link}"
    done
}

_shundle_clean()
{
    _shundle_aux_options
    _shundle_clean__array_tmp="${SHUNDLE_OPTIONS}"
    while [ "${_shundle_clean__array_tmp}" ]; do
        _shundle_clean__element="${_shundle_clean__array_tmp%%,*}"
        _shundle_clean__element="${_shundle_clean__element##*/}"
        _shundle_clean__array="${_shundle_clean__array}${_shundle_clean__element%.*},"
        [ X"${_shundle_clean__array_tmp}" = X"${_shundle_clean__element}" ] &&\
            ${_shundle_clean__array_tmp}='' || _shundle_clean__array_tmp="${_shundle_clean__array_tmp#*,}"
    done

    for plugin in "${SHUNDLE_HOME}"/bundle/*; do
        _shundle_clean__bplugin="${plugin##*/}"
        _shundle_aux_loaded "${_shundle_clean__array}" "${_shundle_clean__bplugin}" && continue #delete only commented plugins
        _shundle_remove "${_shundle_clean__bplugin}"
    done

    #and the other half of the same job: a command is removed from a bundle's
    #Expose line and its link stays behind, answering to a name nothing backs
    #any more. Bundles first, so the links into one just deleted are swept here
    _shundle_expose_orphans | while IFS= read -r _shundle_clean__link; do
        printf "%s\\n" "[-] unlinking ${_shundle_clean__link##*/}"
        rm -f "${_shundle_clean__link}"
    done
}

_shundle_list_links()
{   #'path name' for every link of ours in SHUNDLE_BIN, the path relative to
    #the bundle directory. Read once and kept: this is the only question here
    #that costs a fork per answer, and the links are the truth - what the rc
    #file asks for is a different question, and a clash or a file somebody
    #edited by hand is exactly where the two part ways
    [ -n "${_SHUNDLE_LIST_LINKS}" ] && return 0
    [ -d "${SHUNDLE_BIN}" ] || return 0

    for _shundle_list_links__f in "${SHUNDLE_BIN}"/*; do
        [ -L "${_shundle_list_links__f}" ] || continue
        _shundle_list_links__t="$(readlink "${_shundle_list_links__f}" 2>/dev/null)"
        case "${_shundle_list_links__t}" in
            "${SHUNDLE_HOME}/bundle/"*) ;;
            *) continue ;;
        esac
        _SHUNDLE_LIST_LINKS="${_SHUNDLE_LIST_LINKS}${_shundle_list_links__t#"${SHUNDLE_HOME}/bundle/"} ${_shundle_list_links__f##*/}
"
    done
}

_shundle_list_note()
{   #what you wrote about this bundle: the comment trailing its Bundle line.
    #A repository of commands carries no header to read a description out of,
    #and the rc file is where you already said what it is to you
    [ -r "${SHUNDLE_RC}" ] || return 0
    awk -v want="${1}" '
    /^[ \t]*#/ { next }
    /([bB]undle|[pP]lugin)=/ {
        v = $0; sub(/^[^=]*=/, "", v); gsub(/["\047]/, "", v)
        sub(/[ \t].*$/, "", v); sub(/.*\//, "", v)
        sub(/:.*$/, "", v); sub(/\.git$/, "", v)
        if (v != want) next
        if (!match($0, /#/)) next
        c = substr($0, RSTART + 1)
        gsub(/^[ \t]+|[ \t]+$/, "", c)
        if (c != "") { print c; exit }
    }' "${SHUNDLE_RC}"
}

_shundle_list()
{
    _shundle_list_printf()
    {
        printf "   %b%s%b%s\\n" "${_BIN_SHUNDLE_ENV_GREEN}" "$(printf "%s" "${1}" |  cut -d" " -f1)" \
            "${_BIN_SHUNDLE_ENV_NORMAL}" "$(printf "%s" "${1}" |  cut -d" " -f2-)"
    }

    _shundle_list_commands()
    {   #$1 bundle, $2 non empty to print them all. Without it one line: this
        #is a listing of bundles, and sixty names would bury the next one
        _shundle_list_links
        _shundle_list_commands__n="$(printf "%s" "${_SHUNDLE_LIST_LINKS}" |
            awk -v b="${1}/" '{ if (index($1, b) == 1) print $2 }')"
        [ -z "${_shundle_list_commands__n}" ] && return 0

        _shundle_list_commands__c="$(printf "%s" "${_shundle_list_commands__n}" | wc -l |
            awk '{print $1 + 1}')"
        _shundle_list_commands__in="$(printf "%s" "${SHUNDLE_BIN}" |
            awk -v h="${HOME}" '{sub("^" h, "~"); print}')"

        #the way to see the rest, next to the count that says there is a rest.
        #Not printed when you are already looking at all of them
        _shundle_list_commands__more=""
        [ -z "${2}" ] && [ "${_shundle_list_commands__c}" -gt "3" ] &&
            _shundle_list_commands__more="   \$ shundle list ${1}"

        _shundle_list_printf "Commands:     ${_shundle_list_commands__c} in ${_shundle_list_commands__in}${_shundle_list_commands__more}"

        printf "%s" "${_shundle_list_commands__n}" |
        awk -v all="${2}" -v w="$(( ${COLUMNS:-80} - 18 ))" '
        { word[++n] = $1 }
        END {
            line = ""
            #a taste, no more. Three names say what kind of things live in
            #there; sixty say it no better and bury the bundle underneath
            if (all == "") {
                for (i = 1; i <= n && i <= 3; i++)
                    line = (line == "" ? word[i] : line " " word[i])
                if (n > 3) line = line " ..."
                print "                " line
                exit
            }
            for (i = 1; i <= n; i++) {
                if (line != "" && length(line) + 1 + length(word[i]) > w) {
                    print "                " line
                    line = ""
                }
                line = (line == "" ? word[i] : line " " word[i])
            }
            if (line != "") print "                " line
        }'
    }

    #printf "%b%s%b\\n" "${_BIN_SHUNDLE_ENV_BLUE}" "Plugins:" "${_BIN_SHUNDLE_ENV_NORMAL}"

    for _shundle_list__plugin in "${SHUNDLE_HOME}"/bundle/*; do
        _shundle_list__bplugin="${_shundle_list__plugin##*/}"
        [ -n "${1}" ] && [ ! X"${1}" = X"${_shundle_list__bplugin}" ] && continue
        _shundle_list__name="${_shundle_list__bplugin}"
        if _shundle_aux_loaded ${SHUNDLE_PLUGINS} ${_shundle_list__bplugin}; then
            printf "%b%s%b\\n" "${_BIN_SHUNDLE_ENV_RED}" "${_shundle_list__bplugin}" "${_BIN_SHUNDLE_ENV_NORMAL}"
        else
            printf "%b%s%b\\n" "${_BIN_SHUNDLE_ENV_YELLOW}" "${_shundle_list__bplugin}" "${_BIN_SHUNDLE_ENV_NORMAL}"
        fi

        if [ -d "${SHUNDLE_HOME}/bundle/${_shundle_list__bplugin}/${_shundle_list__bplugin}" ]; then
            _shundle_list__bplugin="${_shundle_list__bplugin}/${_shundle_list__bplugin}"
        fi

        if [ -f "${_shundle_list__plugin}/${_shundle_list__bplugin}" ]; then
            _shundle_list__description="$(head "${_shundle_list__plugin}/${_shundle_list__bplugin}" | sed '/[D|d]escription:/!d' | cut -d" " -f2-)"
            [ -n "${_shundle_list__description}" ] && _shundle_list_printf "${_shundle_list__description}"
            _shundle_list__home="$(head "${_shundle_list__plugin}/${_shundle_list__bplugin}" | sed '/[S|s]ource:/!d' | cut -d" " -f2-)"
            [ -n "${_shundle_list__home}" ] && _shundle_list_printf "${_shundle_list__home}"
            _shundle_list__support="$(head "${_shundle_list__plugin}/${_shundle_list__bplugin}" | sed '/[S|s]hell:/!d' | cut -d" " -f2-)"
            [ -n "${_shundle_list__support}" ] && _shundle_list_printf "${_shundle_list__support}"
        else
            #no file to source means no header to read, and until now that left
            #the name standing on its own. A repository of commands answers the
            #same three questions, it just keeps the answers somewhere else:
            #in your rc file, in git, and in the links it put on your PATH
            _shundle_list__description="$(_shundle_list_note "${_shundle_list__name}")"
            [ -n "${_shundle_list__description}" ] &&
                _shundle_list_printf "Description:  ${_shundle_list__description}"

            _shundle_list__home="$(cd "${_shundle_list__plugin}" 2>/dev/null &&
                git config remote.origin.url 2>/dev/null)"
            [ -n "${_shundle_list__home}" ] &&
                _shundle_list_printf "Source:       ${_shundle_list__home}"

            _shundle_list_commands "${_shundle_list__name}" "${1}"
        fi
    done
}

WGET="$(command -v "wget")"
[ -z "${WGET}" ] && WGET="$(command -v "curl") -O"
[ -z "${WGET}" ] && WGET="$(command -v "fetch")"

if ! _whereis git >/dev/null; then
    _die "shundle: git not found!"
elif [ -z "${WGET}" ]; then
    _die "shundle: wget|curl|fetch not found!"
fi

GIT_VERSION="$(git --version | awk '{gsub("\\.", "");print $NF;exit;}')"

if [ "${#}" -lt 1 ]; then
    _usage
else
    case "${1}" in
        #install|remove|search|update|clean|list) _shundle_$1 "$2";;
        i*) shift; _shundle_install "${@}";;
        r*) shift; _shundle_remove  "${@}";;
        s*) shift; _shundle_search  "${2}";;
        u*) shift; _shundle_update "${@}" ;;
        c*) _shundle_clean  ;;
        l*) shift; _shundle_list "${1}" ;;
         *) _usage          ;;
    esac
fi

# vim: set ts=8 sw=4 tw=0 ft=sh :
